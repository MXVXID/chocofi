#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT_L 0

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <200>;
};

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };


    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <14 19>;
        };

        escape {
            bindings = <&kp ESC>;
            key-positions = <14 15>;
        };
    };


    macros {
        thic_arrow: thic_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "THIC_ARROW";
        };

        thin_arrow: thin_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "THIN_ARROW";
        };

        gte: gte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp EQUAL>;
            label = "GTE";
        };

        lte: lte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp EQUAL>;
            label = "LTE";
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q       &kp W       &kp E             &kp R        &kp T      &kp Y      &kp U        &kp I                &kp O       &kp P
  &hm LGUI A  &hm LALT S  &hm LSHFT D       &hm LCTRL F  &kp G      &kp H      &hm RCTRL J  &hm RSHFT K          &hm RALT L  &hm RGUI SEMI
  &kp Z       &kp X       &kp C             &kp V        &kp B      &kp N      &kp M        &kp COMMA            &kp DOT     &kp FSLH
                          &lt 1 APOSTROPHE  &to 1        &kp RET    &kp SPACE  &kp BSPC     &lt 2 DOUBLE_QUOTES
            >;

            label = "DEF";
        };

        raise_layer {
            bindings = <
  &kp EXCL     &kp AT       &kp HASH      &kp DLLR      &kp PRCNT    &kp AMPS   &kp STAR         &kp LPAR         &kp RPAR       &kp BSLH
  &hm LGUI N1  &hm LALT N2  &hm LSHFT N3  &hm LCTRL N4  &kp N5       &kp MINUS  &hm RCTRL EQUAL  &hm RSHFT GRAVE  &hm RALT LBKT  &hm RGUI RBKT
  &kp N6       &kp N7       &kp N8        &kp N9        &kp N0       &kp UNDER  &kp PLUS         &kp TILDE        &kp LBRC       &kp RBRC
                            &trans        &trans        &trans       &trans     &trans           &trans
            >;

            label = "raise";
        };

        lower_layer {
            bindings = <
  &kp F1   &kp F2   &kp F3     &kp F4  &kp F5     &trans    &trans    &trans  &trans     &trans
  &kp F6   &kp F7   &kp F8     &kp F9  &kp F10    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
  &kp F11  &kp F12  &kp PSCRN  &trans  &trans     &trans    &trans    &trans  &trans     &trans
                    &trans     &trans  &trans     &trans    &trans    &trans
            >;

            label = "lower";
        };

        three_layer {
            bindings = <
  &bootloader   &trans        &trans  &trans         &trans            &trans  &trans  &trans  &trans  &trans
  &bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans         &bt BT_CLR        &trans  &trans  &trans  &trans  &trans
  &bt BT_PRV    &bt BT_NXT    &trans  &bt BT_DISC 0  &bt BT_CLR_ALL    &trans  &trans  &trans  &trans  &trans
                              &trans  &trans         &trans            &trans  &trans  &trans
            >;

            label = "three";
        };

        VIM {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "VIM";
        };
    };
};

