#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_L 0
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41
#define HRM_PRIOR_IDLE_MS 150

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <200>;
};

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    behaviors {
        hm_l: hm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <HRM_PRIOR_IDLE_MS>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };

        hm_r: hm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <HRM_PRIOR_IDLE_MS>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };

        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_MT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        capsword {
            bindings = <&caps_word>;
            key-positions = <12 17>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 2>;
        };

        escape {
            bindings = <&kp ESC>;
            key-positions = <7 8>;
        };
    };

    macros {
        thic_arrow: thic_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "THIC_ARROW";
        };

        thin_arrow: thin_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "THIN_ARROW";
        };

        gte: gte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp EQUAL>;
            label = "GTE";
        };

        lte: lte {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp EQUAL>;
            label = "LTE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W          &kp E  &kp R      &kp T          &kp Y              &kp U         &kp I            &kp O             &kp P      &hm_l LGUI A  &hm_l LALT S
&hm_l LSHFT D  &hm_l LCTRL F  &kp G  &kp H      &hm_r RCTRL J  &hm_r RSHFT K      &hm_r RALT L  &hm_r RGUI SEMI  &my_mt LG(TAB) Z  &kp X      &kp C         &kp V
&kp B          &kp N          &kp M  &kp COMMA  &kp DOT        &my_mt ESC FSLH    &kp LGUI      &mo 1            &kp RET           &kp SPACE  &kp BSPC      &mo 2
            >;

            label = "DEF";
        };

        raise_layer {
            bindings = <
&kp EXCL        &kp AT          &kp HASH  &kp DLLR          &kp PRCNT          &kp AMPS             &kp STAR         &kp LPAR         &kp RPAR  &kp BSLH  &hm_l LGUI N1  &hm_l LALT N2
&hm_l LSHFT N3  &hm_l LCTRL N4  &kp N5    &kp MINUS         &hm_r RCTRL EQUAL  &hm_r RSHFT GRAVE    &hm_r RALT LBKT  &hm_r RGUI RBKT  &kp N6    &kp N7    &kp N8         &kp N9
&kp N0          &kp UNDER       &kp PLUS  &kp SINGLE_QUOTE  &kp LBRC           &kp RBRC             &trans           &trans           &trans    &trans    &trans         &trans
            >;

            label = "raise";
        };

        lower_layer {
            bindings = <
&kp F1  &kp F2     &kp F3     &kp F4    &kp F5    &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &msc SCRL_UP  &kp F6     &kp F7
&kp F8  &kp F9     &kp F10    &kp LEFT  &kp DOWN  &kp UP            &kp RIGHT       &msc SCRL_DOWN  &kp F11          &kp F12       &kp PSCRN  &kp LG(LS(LC(PRINTSCREEN)))
&trans  &mkp LCLK  &mkp RCLK  &trans    &trans    &trans            &trans          &trans          &trans           &trans        &trans     &trans
            >;

            label = "lower";
        };

        three_layer {
            bindings = <
&bootloader     &trans         &trans      &trans            &trans      &kp C_BRIGHTNESS_AUTO    &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &trans      &trans      &bt BT_SEL 0  &bt BT_SEL 1
&trans          &bt BT_DISC 1  &bt BT_CLR  &kp K_PLAY_PAUSE  &kp K_PREV  &kp K_NEXT               &kp C_REPEAT          &kp K_MUTE            &bt BT_PRV  &bt BT_NXT  &trans        &bt BT_DISC 0
&bt BT_CLR_ALL  &trans         &trans      &trans            &trans      &trans                   &trans                &trans                &trans      &trans      &trans        &trans
            >;

            label = "three";
        };

        VIM {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp K_COPY    &trans  &trans  &trans  &kp K_PASTE  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans       &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans       &trans  &trans
            >;

            label = "VIM";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        if {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
